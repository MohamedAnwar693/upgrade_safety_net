<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Comparison ================= -->
    <record id="usn_comparison_view_list" model="ir.ui.view">
        <field name="name">usn.comparison.list</field>
        <field name="model">usn.comparison</field>
        <field name="arch" type="xml">
            <list decoration-danger="verdict == 'critical'" decoration-warning="verdict == 'attention'">
                <field name="name"/>
                <field name="before_series"/>
                <field name="after_series"/>
                <field name="ran_on"/>
                <field name="critical_count"/>
                <field name="warning_count"/>
                <field name="info_count"/>
                <field name="verdict" widget="badge"
                       decoration-danger="verdict == 'critical'" decoration-warning="verdict == 'attention'"
                       decoration-success="verdict == 'clean'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="usn_comparison_view_form" model="ir.ui.view">
        <field name="name">usn.comparison.form</field>
        <field name="model">usn.comparison</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_rerun" type="object" string="Re-run comparison"
                            invisible="state == 'waiting'"/>
                    <button name="%(upgrade_safety_net.usn_comparison_report_action)d" type="action"
                            string="Print report" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_critical" type="object" class="oe_stat_button" icon="fa-exclamation-circle"
                                invisible="state != 'done'">
                            <field name="critical_count" widget="statinfo" string="Critical"/>
                        </button>
                        <button name="action_view_warning" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="state != 'done'">
                            <field name="warning_count" widget="statinfo" string="Warnings"/>
                        </button>
                        <button name="action_view_info" type="object" class="oe_stat_button" icon="fa-info-circle"
                                invisible="state != 'done'">
                            <field name="info_count" widget="statinfo" string="Info"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'waiting'">
                        Waiting for the "after" snapshot to finish
                        (<field name="after_progress" widget="percentage" class="oe_inline"/>).
                        The comparison runs automatically.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="verdict != 'critical' or state != 'done'">
                        <b>Possible data loss.</b> Review the critical findings below before going live.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="verdict != 'attention' or state != 'done'">
                        No unexplained data loss, but some findings need review.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="verdict != 'clean' or state != 'done'">
                        No differences found.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <field name="error" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="before_id" readonly="state != 'waiting' or id"/>
                            <field name="after_id" readonly="id" placeholder="Current database (new snapshot)"/>
                        </group>
                        <group>
                            <field name="ran_on"/>
                            <field name="verdict"/>
                            <field name="auto_created"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="usn_comparison_action" model="ir.actions.act_window">
        <field name="name">Comparisons</field>
        <field name="res_model">usn.comparison</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Findings ================= -->
    <record id="usn_comparison_line_view_list" model="ir.ui.view">
        <field name="name">usn.comparison.line.list</field>
        <field name="model">usn.comparison.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                  decoration-danger="severity == 'critical' and state == 'open'"
                  decoration-warning="severity == 'warning' and state == 'open'"
                  decoration-muted="state == 'ack'">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge"/>
                    <button name="action_reopen" type="object" string="Re-open"/>
                </header>
                <field name="comparison_id" column_invisible="context.get('default_comparison_id')" optional="hide"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'"
                       decoration-info="severity == 'info'"/>
                <field name="kind"/>
                <field name="subject"/>
                <field name="before"/>
                <field name="after"/>
                <field name="delta_pct" widget="percentage" optional="hide"/>
                <field name="hint" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="usn_comparison_line_view_form" model="ir.ui.view">
        <field name="name">usn.comparison.line.form</field>
        <field name="model">usn.comparison.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" invisible="state != 'open'"/>
                    <button name="action_reopen" type="object" string="Re-open" invisible="state != 'ack'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="comparison_id"/>
                            <field name="severity"/>
                            <field name="kind"/>
                            <field name="category"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="table"/>
                            <field name="column"/>
                            <field name="before"/>
                            <field name="after"/>
                            <field name="delta"/>
                            <field name="delta_pct"/>
                        </group>
                    </group>
                    <group string="What this means">
                        <field name="hint" nolabel="1"/>
                    </group>
                    <group>
                        <field name="ack_note"/>
                        <field name="ack_user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="usn_comparison_line_view_search" model="ir.ui.view">
        <field name="name">usn.comparison.line.search</field>
        <field name="model">usn.comparison.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="model"/>
                <field name="table"/>
                <field name="column"/>
                <field name="comparison_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="acknowledged" string="Acknowledged" domain="[('state', '=', 'ack')]"/>
                <separator/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <filter name="warning" string="Warning" domain="[('severity', '=', 'warning')]"/>
                <separator/>
                <filter name="cat_data" string="Data loss" domain="[('category', '=', 'data')]"/>
                <filter name="cat_totals" string="Totals shifted" domain="[('category', '=', 'totals')]"/>
                <filter name="cat_custom" string="Customisations" domain="[('category', '=', 'custom')]"/>
                <filter name="cat_modules" string="Modules" domain="[('category', '=', 'modules')]"/>
                <group>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_table" string="Table" context="{'group_by': 'table'}"/>
                    <filter name="group_comparison" string="Comparison" context="{'group_by': 'comparison_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="usn_comparison_line_action" model="ir.actions.act_window">
        <field name="name">Findings</field>
        <field name="res_model">usn.comparison.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_severity': 1}</field>
    </record>
</odoo>
