<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="usn_metric_definition_view_list" model="ir.ui.view">
        <field name="name">usn.metric.definition.list</field>
        <field name="model">usn.metric.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="group"/>
                <field name="code"/>
                <field name="required_tables" optional="hide"/>
                <field name="is_builtin" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="usn_metric_definition_view_form" model="ir.ui.view">
        <field name="name">usn.metric.definition.form</field>
        <field name="model">usn.metric.definition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test" type="object" string="Test query"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="group"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="required_tables"/>
                            <field name="label_model"/>
                            <field name="tolerance"/>
                            <field name="is_builtin"/>
                        </group>
                    </group>
                    <group string="Query">
                        <field name="query" nolabel="1" widget="ace" options="{'mode': 'sql'}"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="usn_metric_definition_action" model="ir.actions.act_window">
        <field name="name">Watched Totals</field>
        <field name="res_model">usn.metric.definition</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Settings ================= -->
    <record id="usn_config_view_form" model="ir.ui.view">
        <field name="name">usn.config.form</field>
        <field name="model">usn.config</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <h1>Upgrade Safety Net Settings</h1>
                    <group string="After the upgrade">
                        <field name="auto_compare"/>
                    </group>
                    <group string="Sensitivity">
                        <group>
                            <field name="shrink_threshold_pct"/>
                            <field name="critical_shrink_pct"/>
                            <field name="min_rows"/>
                        </group>
                        <group>
                            <field name="metric_critical_pct"/>
                            <field name="rename_hint_min_filled"/>
                        </group>
                    </group>
                    <group string="Scope">
                        <field name="excluded_tables"/>
                        <field name="excluded_columns"/>
                    </group>
                    <group string="Performance">
                        <field name="time_budget"/>
                        <field name="statement_timeout"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="usn_open_config_action" model="ir.actions.server">
        <field name="name">Upgrade Safety Net Settings</field>
        <field name="model_id" ref="model_usn_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
